{
  "$id": "urn:devlink:local-broker:v1:credentials",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "brokerUrl": {
      "type": "string",
      "pattern": "^http:\\/\\/127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])\\/?$"
    },
    "localToken": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\x00-\\x20\\x7f-\\x9f\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]+$",
      "maxLength": 128
    }
  },
  "required": [
    "schemaVersion",
    "brokerUrl",
    "localToken"
  ],
  "additionalProperties": false
}
