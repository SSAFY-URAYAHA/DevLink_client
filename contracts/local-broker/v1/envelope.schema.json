              "maxLength": 128
            },
            "requestKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\x00-\\x20\\x7f-\\x9f\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]+$",
              "maxLength": 128
            }
          },
          "required": [
            "code"
          ]
        }
      },
      "required": [
        "requestId",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
