{
  "name": "@devlink/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevLink local MCP runtime",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node scripts/export-contracts.mjs --check && node --test --test-concurrency=1 test/*.test.mjs",
    "test:hosts": "npm run build && node scripts/verify-hosts.mjs",
    "contracts:write": "npm run build && node scripts/export-contracts.mjs",
    "contracts:check": "npm run build && node scripts/export-contracts.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
